   "parameters": {
    "jsCode": "let input = $json;\nif (Array.isArray(input)) input = input[0];\nif (input?.body) input = input.body;\nconst query = String(input.query || '').trim().toLowerCase();\nif (query.length < 2) throw new Error('Query too short');\nif (query.length > 120) throw new Error('Query too long');\nreturn [{ json: { query, queryLike: '%' + query + '%' } }];"
