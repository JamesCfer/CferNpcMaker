   "parameters": {
    "jsCode": "const input = $('Session Validation Node').first().json;\nconst sessions = $input.all().map(i => i.json);\nconst sessionData = sessions && sessions.length > 0 ? sessions[0] : null;\nif (!sessionData || !sessionData.key) return [{ json: { authorized: false, error: 'SESSION_NOT_FOUND', message: 'Session expired or invalid.', requiresAuth: true } }];\nconst now = new Date();\nconst expiresAt = new Date(sessionData.expires_at);\nif (expiresAt < now) return [{ json: { authorized: false, error: 'SESSION_EXPIRED', message: 'Your session has expired.', requiresAuth: true } }];\nconst isSuperuser = sessionData.superuser === true;\nconst tier = sessionData.tier ? String(sessionData.tier).trim() : '';\nreturn [{ json: { authorized: true, sessionEmail: sessionData.email, sessionTier: tier, sessionIsSuperuser: isSuperuser, sessionKey: sessionData.key, ...input } }];"
