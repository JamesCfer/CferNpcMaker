   "parameters": {
    "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.name);\nconst results = rows.map(r => ({\n  name: r.name, level: Number(r.level) || 0, price: r.price || '',\n  priceCp: Number(r.price_cp) || 0, rarity: r.rarity || 'common',\n  category: r.category || '', url: r.url || '',\n})).sort((a, b) => a.level - b.level || a.name.localeCompare(b.name));\nreturn [{ json: { ok: true, results, source: 'Archives of Nethys (cached)' } }];"
   }
