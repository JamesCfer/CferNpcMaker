   "parameters": {
    "jsCode": "const headers = $json.headers || {};\nconst body = $json.body || {};\nconst query = $json.query || {};\nconst sessionKey = headers['x-builder-key'] || headers['X-Builder-Key'] || body.sessionKey || query.sessionKey || null;\nconst origin = headers['x-foundry-origin'] || headers['X-Foundry-Origin'] || body.origin || query.origin || '';\nif (!sessionKey) return [{ json: { authorized: false, error: 'NO_SESSION_KEY', message: 'Missing session key.', requiresAuth: true } }];\nif (sessionKey.length !== 32 || !/^[a-f0-9]{32}$/.test(sessionKey)) return [{ json: { authorized: false, error: 'INVALID_SESSION_FORMAT', message: 'Invalid session key format.', requiresAuth: true } }];\nreturn [{ json: { ...($json), sessionKey, requestOrigin: origin, _needsValidation: true } }];"
   }
