  {
   "id": "fetch-5et",
   "name": "Fetch 5eTools Items",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    400,
    0
   ],
   "parameters": {
    "jsCode": "// Pull the full 5eTools item dataset (community mirror).\n// HTTP shim: $helpers (main process) / this.helpers (task runner) / global fetch.\nconst __helpers = (typeof $helpers !== 'undefined' && $helpers) ? $helpers\n  : ((typeof this !== 'undefined' && this && this.helpers) ? this.helpers : null);\nasync function __request(opts) {\n  if (__helpers && __helpers.httpRequest) return __helpers.httpRequest(opts);\n  if (typeof fetch === 'function') {\n    const r = await fetch(opts.url, { method: opts.method || 'GET', headers: opts.headers || {}, body: opts.body });\n    return await r.text();\n  }\n  throw new Error('No HTTP capability in this Code node runtime.');\n}\nasync function fetchJson(url) {\n  const resp = await __request({ url, json: false });\n  return typeof resp === 'string' ? JSON.parse(resp) : resp;\n}\nconst RARITY_MAP = { none: '', common: 'common', uncommon: 'uncommon', rare: 'rare', 'very rare': 'veryRare', legendary: 'legendary', artifact: 'artifact' };\nconst items = await fetchJson('https://raw.githubusercontent.com/5etools-mirror-3/5etools-src/main/data/items.json');\nconst bases = await fetchJson('https://raw.githubusercontent.com/5etools-mirror-3/5etools-src/main/data/items-base.json');\nconst pool = [...(items.item || []), ...(bases.baseitem || [])];\nconst all = [];\nfor (const i of pool) {\n  if (!i.name) continue;\n  const cp = Number(i.value) || 0;\n  const compact = { ...i };\n  if (Array.isArray(compact.entries)) compact.entries = compact.entries.slice(0, 20);\n  all.push({ json: {\n    name: String(i.name).slice(0, 200),\n    name_lower: String(i.name).toLowerCase().slice(0, 200),\n    rarity: RARITY_MAP[String(i.rarity || '').toLowerCase()] ?? '',\n    price: cp ? (cp >= 100 ? (cp / 100) + ' gp' : (cp / 10) + ' sp') : '',\n    price_cp: cp,\n    book: String(i.source || '').slice(0, 30),\n    data: JSON.stringify(compact).slice(0, 5000),\n  } });\n}\nif (!all.length) throw new Error('5eTools scrape returned nothing — aborting so the cache is not wiped empty.');\nreturn all;"
   }
  },
