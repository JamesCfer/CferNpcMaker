  {
   "id": "fetch-aon",
   "name": "Fetch AoN Items",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -200,
    0
   ],
   "parameters": {
    "jsCode": "// Page through every AoN equipment/weapon/armor/shield entry.\n// HTTP shim: $helpers (main process) / this.helpers (task runner) / global fetch.\nconst __helpers = (typeof $helpers !== 'undefined' && $helpers) ? $helpers\n  : ((typeof this !== 'undefined' && this && this.helpers) ? this.helpers : null);\nasync function __request(opts) {\n  if (__helpers && __helpers.httpRequest) return __helpers.httpRequest(opts);\n  if (typeof fetch === 'function') {\n    const r = await fetch(opts.url, { method: opts.method || 'GET', headers: opts.headers || {}, body: opts.body });\n    return await r.text();\n  }\n  throw new Error('No HTTP capability in this Code node runtime.');\n}\nfunction priceCp(raw) {\n  let cp = 0;\n  const re = /(\\d+)\\s*(pp|gp|sp|cp)/gi;\n  let m;\n  while ((m = re.exec(String(raw || '')))) cp += Number(m[1]) * ({ pp: 1000, gp: 100, sp: 10, cp: 1 })[m[2].toLowerCase()];\n  return cp;\n}\nconst all = [];\nlet from = 0;\nwhile (from < 10000) {\n  const body = JSON.stringify({\n    from, size: 1000,\n    _source: ['name', 'category', 'item_category', 'level', 'price_raw', 'rarity', 'trait_raw', 'bulk_raw', 'usage', 'text', 'url'],\n    query: { bool: { filter: [{ terms: { category: ['equipment', 'weapon', 'armor', 'shield'] } }] } },\n  });\n  const resp = await __request({\n    method: 'POST', url: 'https://elasticsearch.aonprd.com/aon/_search',\n    headers: { 'Content-Type': 'application/json' }, body, json: false,\n  });\n  const parsed = typeof resp === 'string' ? JSON.parse(resp) : resp;\n  const hits = parsed?.hits?.hits || [];\n  for (const h of hits) {\n    const s = h._source || {};\n    if (!s.name) continue;\n    all.push({ json: {\n      name: String(s.name).slice(0, 200),\n      name_lower: String(s.name).toLowerCase().slice(0, 200),\n      level: Number(s.level) || 0,\n      price: String(s.price_raw || '').slice(0, 60),\n      price_cp: priceCp(s.price_raw),\n      rarity: String(s.rarity || 'common'),\n      category: String(s.item_category || s.category || '').slice(0, 60),\n      url: s.url ? 'https://2e.aonprd.com' + s.url : '',\n      data: JSON.stringify({\n        name: s.name, category: s.category, itemCategory: s.item_category,\n        level: s.level, price: s.price_raw, rarity: s.rarity,\n        traits: s.trait_raw || [], bulk: s.bulk_raw || '', usage: s.usage || '',\n        text: String(s.text || '').slice(0, 4000),\n      }),\n    } });\n  }\n  if (hits.length < 1000) break;\n  from += 1000;\n}\nif (!all.length) throw new Error('AoN scrape returned nothing — aborting so the cache is not wiped empty.');\nreturn all;"
   }
  },
