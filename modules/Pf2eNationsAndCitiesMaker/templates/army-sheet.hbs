<div class="pf2e-army">

  <div class="pf2e-army-header">
    <i class="fa-solid fa-shield-halved"></i>
    <h2>{{doc.name}}</h2>
    <span class="pf2e-settlement-kind-pill">Army</span>
  </div>

  <div class="pf2e-army-summary">
    <div class="pf2e-nation-stat"><label>Total Units</label><span>{{totalUnits}}</span></div>
    <div class="pf2e-nation-stat">
      <label>Stationed At</label>
      {{#if stationedAtName}}
        <span><a href="#" data-action="openStationedAt">{{stationedAtName}}</a></span>
      {{else}}
        <span>&mdash;</span>
      {{/if}}
    </div>
  </div>

  <label>Stationed At
    <select name="stationedAt" data-path="stationedAt" data-action="saveField" style="width:100%;margin-top:0.25em;">
      <option value="">&mdash; none &mdash;</option>
      {{#each availableJournals}}
        <option value="{{id}}" {{#if (eqStr id ../army.stationedAt)}}selected{{/if}}>{{name}}</option>
      {{/each}}
    </select>
  </label>

  <label>Mode
    <select name="mode" data-path="mode" data-action="saveField" style="width:100%;margin-top:0.25em;">
      <option value="garrison" {{#if (eqStr army.mode "garrison")}}selected{{/if}}>Garrison (defends this settlement)</option>
      <option value="field" {{#if (eqStr army.mode "field")}}selected{{/if}}>Field army (can march)</option>
    </select>
  </label>

  <label>Owner Nation
    <select name="ownerNationId" data-path="ownerNationId" data-action="saveField" style="width:100%;margin-top:0.25em;">
      <option value="">&mdash; none &mdash;</option>
      {{#each availableNations}}
        <option value="{{id}}" {{#if (eqStr id ../army.ownerNationId)}}selected{{/if}}>{{name}}</option>
      {{/each}}
    </select>
  </label>

  <label>Supply Source
    <select name="supplySource" data-path="supplySource" data-action="saveField" style="width:100%;margin-top:0.25em;">
      <option value="">&mdash; none (unsupplied) &mdash;</option>
      {{#each availableJournals}}
        <option value="{{id}}" {{#if (eqStr id ../army.supplySource)}}selected{{/if}}>{{name}}</option>
      {{/each}}
    </select>
  </label>
  {{#if supplyStatus}}
    <p class="pf2e-empty">
      {{#if supplyStatus.supplied}}
        <i class="fa-solid fa-wheat-awn"></i> Supplied by {{supplyStatus.sourceName}} ({{supplyStatus.need}} needed / {{supplyStatus.capacity}} available).
      {{else}}
        <i class="fa-solid fa-triangle-exclamation"></i> Cut off from {{supplyStatus.sourceName}} ({{supplyStatus.need}} needed / {{supplyStatus.capacity}} available) — morale is dropping.
      {{/if}}
    </p>
  {{/if}}

  <h3><i class="fa-solid fa-user-tie"></i> Commander</h3>
  <div class="pf2e-army-commander-drop" data-commander-drop>
    {{#if commanderActor}}
      <div class="pf2e-npc-chip pf2e-npc-chip--inline">
        <img src="{{commanderActor.portrait}}" class="pf2e-npc-chip-portrait" alt="{{commanderActor.name}}" />
        <span>{{commanderActor.name}}</span>
        <span class="pf2e-npc-chip-level">Lv {{commanderActor.level}}</span>
        <button type="button" class="pf2e-icon-btn" data-action="openCommander" title="Open commander">
          <i class="fa-solid fa-arrow-up-right-from-square"></i>
        </button>
        <button type="button" class="pf2e-icon-btn pf2e-icon-btn--danger" data-action="clearCommander" title="Remove commander">
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
    {{else}}
      <em class="pf2e-empty">Drop an Actor here to set a commander — their level adds a flat power bonus in battles and sieges.</em>
    {{/if}}
  </div>

  <div class="pf2e-army-summary">
    <div class="pf2e-nation-stat">
      <label>March Status</label>
      {{#if army.destination}}
        <span>Marching to <strong>{{destinationName}}</strong> — arrives {{arrivalDateLabel}}</span>
      {{else}}
        <span>&mdash;</span>
      {{/if}}
    </div>
  </div>

  <button type="button" class="pf2e-settlement-btn" data-action="sendArmy">
    <i class="fa-solid fa-route"></i> Send Army
  </button>
  {{#if army.destination}}
    <button type="button" class="pf2e-settlement-btn" data-action="cancelMarch">
      <i class="fa-solid fa-ban"></i> Cancel March
    </button>
  {{/if}}

  <h3><i class="fa-solid fa-people-group"></i> Unit Roster</h3>
  {{#if army.units.length}}
    <table class="pf2e-nation-cities">
      <thead><tr><th>Type</th><th>Count</th><th>Level</th><th>Equipment</th><th>Morale</th><th></th></tr></thead>
      <tbody>
        {{#each army.units}}
          <tr>
            <td>
              <select data-path="units.{{@index}}.type" data-action="saveField">
                {{#each ../unitTypes}}
                  <option value="{{this}}" {{#if (eqStr this ../type)}}selected{{/if}}>{{this}}</option>
                {{/each}}
              </select>
            </td>
            <td>
              <input type="number" min="0" step="1" data-path="units.{{@index}}.count"
                     data-action="saveField" value="{{count}}" style="width:5em;" />
            </td>
            <td>
              <input type="number" min="0" max="30" step="1" data-path="units.{{@index}}.level"
                     data-action="saveField" value="{{level}}" style="width:4em;" />
            </td>
            <td>
              <input type="text" data-path="units.{{@index}}.equipment"
                     data-action="saveField" value="{{equipment}}" style="width:100%;" />
            </td>
            <td>
              <input type="number" min="0" max="100" step="1" data-path="units.{{@index}}.morale"
                     data-action="saveField" value="{{morale}}" style="width:4em;" />
            </td>
            <td>
              <button type="button" class="pf2e-icon-btn pf2e-icon-btn--danger"
                      data-action="removeUnit" data-unit-id="{{id}}" title="Remove unit">
                <i class="fa-solid fa-trash"></i>
              </button>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <em class="pf2e-empty">No units recruited yet.</em>
  {{/if}}

  <button type="button" class="pf2e-settlement-btn" data-action="addUnit">
    <i class="fa-solid fa-plus"></i> Add Unit
  </button>
  <button type="button" class="pf2e-settlement-btn" data-action="recruitUnits">
    <i class="fa-solid fa-coins"></i> Recruit Units
  </button>
  <button type="button" class="pf2e-settlement-btn" data-action="resolveBattle">
    <i class="fa-solid fa-shield-halved"></i> Resolve Battle
  </button>
  <button type="button" class="pf2e-settlement-btn" data-action="siegeSettlement">
    <i class="fa-solid fa-chess-rook"></i> Siege Settlement
  </button>

  <h3><i class="fa-solid fa-scroll"></i> Notes</h3>
  <textarea data-path="notes" rows="6">{{army.notes}}</textarea>
  <button type="button" class="pf2e-settlement-btn" data-action="saveNotes">
    <i class="fa-solid fa-floppy-disk"></i> Save notes
  </button>

</div>
